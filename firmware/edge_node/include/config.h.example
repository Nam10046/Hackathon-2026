// Copy this file to include/config.h and fill it in. config.h is git-ignored (never commit passwords or keys).
#pragma once

#define WIFI_SSID      "your-wifi"
#define WIFI_PASSWORD  "your-password"

// IP of the laptop running docker compose (PowerShell: ipconfig -> "IPv4 Address" of your Wi-Fi adapter).
// MQTT is already open to the network (MQTT_BIND=0.0.0.0 in docker-compose).
#define MQTT_HOST      "192.168.1.50"
#define MQTT_PORT      1883

#define SITE_ID "S1"               // the site; its compactors (C1 cardboard, C2 plastic, C3 mixed) are in src/main.cpp
#define TIME_SCALE 60              // 60 = fast demo (1 min = 1 h), 1 = real time. Same as DEMO_TIME_SCALE in .env

// Signing key: the same text must be in the backend .env as DEVICE_KEYS=C1:<this key>
#define DEVICE_KEY     "change-me-to-a-long-random-secret"

// Demo speed: how often a reading is sent, and how fast the simulated compactor fills
#define REPORT_MS          10000     // one reading every 10 s (a real unit: every 15-60 min)
