# Copy to .env to change settings (optional — the defaults below are used without it).
# NEVER commit .env
STACK_NAME=compactor
TIMEZONE=Europe/Helsinki

# Database — local postgres container (default):
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=disable
DB_USER=compactor
DB_PASS=compactor
DB_NAME=compactor

# Database — TigerData (shared cloud DB for the whole team). Replace the block above with
# the values from Tiger Console -> your service -> Connect:
# DB_HOST=<xxxx>.tsdb.cloud.timescale.com
# DB_PORT=<port shown in console>
# DB_SSLMODE=require
# DB_USER=tsdbadmin
# DB_PASS=<password>
# DB_NAME=tsdb

# Grafana admin password (viewing needs no login)
GRAFANA_PASS=admin

# 127.0.0.1 = only this laptop. 0.0.0.0 = teammates on the same Wi-Fi can open Grafana etc.
BIND_ADDR=127.0.0.1
# MQTT must be reachable by the ESP32 over Wi-Fi
MQTT_BIND=0.0.0.0

# If set, sending readings needs header X-API-Key: <this>. Empty = open (fine on your laptop).
INGEST_API_KEY=

# Only for running the backend WITHOUT Docker:
# DATABASE_URL=sqlite:///./local.db

# Edge node (firmware/edge_node): device signing keys, same text as DEVICE_KEY in its config.h
DEVICE_KEYS=
DEMO_TIME_SCALE=1
READING_INTERVAL_H=1
SITE_ID=S1
