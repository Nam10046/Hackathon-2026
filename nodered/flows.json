[
  {
    "id": "tab_ingest",
    "type": "tab",
    "label": "Compactor ingest",
    "disabled": false,
    "info": "MQTT readings -> backend API. Owner: backend/hardware. Add alert actions (email, Telegram, Slack) after the 'Alerts only' node."
  },
  {
    "id": "broker_local",
    "type": "mqtt-broker",
    "name": "Mosquitto",
    "broker": "mosquitto",
    "port": "1883",
    "clientid": "nodered",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true
  },
  {
    "id": "mqtt_in_readings",
    "type": "mqtt in",
    "z": "tab_ingest",
    "name": "compactor/+/reading",
    "topic": "compactor/+/reading",
    "qos": "1",
    "datatype": "json",
    "broker": "broker_local",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 160,
    "y": 120,
    "wires": [["http_post_reading"]]
  },
  {
    "id": "http_post_reading",
    "type": "http request",
    "z": "tab_ingest",
    "name": "POST /api/readings",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "http://backend:8000/api/readings",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "x": 410,
    "y": 120,
    "wires": [["fn_alerts_only", "debug_response"]]
  },
  {
    "id": "fn_alerts_only",
    "type": "function",
    "z": "tab_ingest",
    "name": "Alerts only",
    "func": "// Pass on only warnings/critical alerts from the backend response\nif (msg.statusCode !== 200) {\n    node.warn(`Backend error ${msg.statusCode}: ${JSON.stringify(msg.payload)}`);\n    return null;\n}\nconst alerts = (msg.payload.alerts || []).filter(a => a.severity !== 'info');\nif (alerts.length === 0) return null;\nmsg.payload = alerts;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 650,
    "y": 100,
    "wires": [["debug_alerts"]]
  },
  {
    "id": "debug_alerts",
    "type": "debug",
    "z": "tab_ingest",
    "name": "ALERTS (connect email/Telegram here)",
    "active": true,
    "tosidebar": true,
    "console": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 920,
    "y": 100,
    "wires": []
  },
  {
    "id": "debug_response",
    "type": "debug",
    "z": "tab_ingest",
    "name": "backend response",
    "active": false,
    "tosidebar": true,
    "console": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 660,
    "y": 160,
    "wires": []
  }
]
