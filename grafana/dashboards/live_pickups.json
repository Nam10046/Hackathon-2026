    {
      "type": "table",
      "title": "All pickups",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compactor-pg"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compactor-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT p.id AS \"#\", p.done_at AS \"Emptied\", p.compactor_id AS \"Compactor\", c.material AS \"Material\", p.kind AS \"Who\", p.load_before_pct AS \"Load %\", p.kg_collected AS \"kg\", p.wait_hours AS \"Wait (site h)\", p.full_hours AS \"Full for (site h)\", CASE p.verdict WHEN 'ON_TIME' THEN '≥60%' WHEN 'TOO_EARLY' THEN '<60%' WHEN 'TOO_LATE' THEN 'Full 2h+' ELSE p.verdict END AS \"Verdict\", p.verdict_reason AS \"Why\", round((-(coalesce(m.lift_fee_eur, p.fee_eur, 0) - (p.kg_collected * m.price_eur_per_kg)))::numeric, 2) AS \"Net €\", CASE p.truck_on_time WHEN TRUE THEN 'yes' WHEN FALSE THEN 'no' ELSE '–' END AS \"Truck on time\", CASE p.weighbridge_on_time WHEN TRUE THEN 'yes' WHEN FALSE THEN 'no' ELSE '–' END AS \"Weighbridge on time\" FROM pickups p JOIN compactors c ON c.id = p.compactor_id JOIN materials m ON m.name = c.material WHERE p.status = 'done' AND $__timeFilter(p.done_at) ORDER BY p.done_at DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Verdict"
