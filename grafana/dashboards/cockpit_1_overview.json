          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compactor-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('month', found_at) AS \"time\", CASE entity_type WHEN 'collection' THEN 'lift findings' ELSE 'invoice findings' END AS metric, count(*) AS n FROM cp_flags WHERE $__timeFilter(found_at) GROUP BY 1, 2 ORDER BY 1"
