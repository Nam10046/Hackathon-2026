    {
      "title": "Which problems cost the most?",
      "description": "",
      "type": "bargauge",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compactor-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compactor-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE label_family WHEN 'COST_PER_T_HIGH' THEN 'Very high cost per tonne' WHEN 'PREMATURE_UNJUSTIFIED' THEN 'Emptied too early' WHEN 'DELAYED_COLLECTION' THEN 'Emptied too late (overflow risk)' WHEN 'WEIGHT_DISCREPANCY' THEN 'Our scale and truck scale disagree' WHEN 'CONTAMINATION_VALUE_LOSS' THEN 'Dirty load lost its value' WHEN 'REJECTED_LOAD' THEN 'Load rejected' WHEN 'OUTDATED_TARIFF' THEN 'Old price on invoice' WHEN 'DUPLICATE_LINE' THEN 'Charged twice' WHEN 'WRONG_SURCHARGE' THEN 'Wrong extra fee' WHEN 'WEIGHT_BASIS_MISMATCH' THEN 'Invoice tonnes differ from truck scale' WHEN 'UNMATCHED_LINE' THEN 'Charge without a lift' WHEN 'MISSING_LINE' THEN 'Charge or credit missing' WHEN 'UNINVOICED_COLLECTION' THEN 'Lift never invoiced' ELSE label_family END AS \"Problem\", round(sum(eur_at_stake)::numeric) AS \"EUR\" FROM cp_flags GROUP BY 1 HAVING sum(eur_at_stake) > 0 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#5794F2"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "text",
        "showUnfilled": true,
        "namePlacement": "left",
        "sizing": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/EUR/",
          "values": true
        }
      },
      "id": 5
    },
