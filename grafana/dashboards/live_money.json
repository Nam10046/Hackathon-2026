    {
      "type": "table",
      "title": "Every pickup, priced with your prices",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compactor-pg"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compactor-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT p.id AS \"Pickup\", p.done_at AS \"Emptied\", p.compactor_id AS \"Compactor\", c.material AS \"Material\", p.kg_collected AS \"kg\", round((coalesce(m.lift_fee_eur, p.fee_eur, 0))::numeric, 2) AS \"Lift cost €\", round(((p.kg_collected * m.price_eur_per_kg))::numeric, 2) AS \"Material value €\", round(((coalesce(m.lift_fee_eur, p.fee_eur, 0) - (p.kg_collected * m.price_eur_per_kg)))::numeric, 2) AS \"Total cost €\", round((((coalesce(m.lift_fee_eur, p.fee_eur, 0) - (p.kg_collected * m.price_eur_per_kg))) / NULLIF(p.kg_collected / 1000, 0))::numeric, 2) AS \"€ / t\", p.co2_kg AS \"CO₂ saved kg\" FROM pickups p JOIN compactors c ON c.id = p.compactor_id JOIN materials m ON m.name = c.material WHERE p.status = 'done' AND $__timeFilter(p.done_at) ORDER BY p.done_at DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 112
    },
