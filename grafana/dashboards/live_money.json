    {
      "type": "table",
      "title": "Invoice check: their bill vs our measurement",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compactor-pg"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compactor-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT p.id AS \"Pickup\", p.done_at AS \"Emptied\", p.compactor_id AS \"Compactor\", c.material AS \"Material\", p.kg_collected AS \"We measured kg\", p.invoice_kg AS \"Billed kg\", p.fee_eur AS \"Contract fee €\", p.invoice_fee_eur AS \"Billed fee €\", p.invoice_check AS \"Check\", p.claim_eur AS \"Claim €\" FROM pickups p JOIN compactors c ON c.id = p.compactor_id WHERE p.status = 'done' AND $__timeFilter(p.done_at) ORDER BY (p.invoice_check <> 'OK') DESC, p.done_at DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Check"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "OK": {
                        "color": "green",
                        "index": 0
                      },
                      "WEIGHT_MISMATCH": {
                        "color": "red",
                        "index": 1
                      },
                      "WRONG_FEE": {
                        "color": "red",
                        "index": 2
                      },
                      "WEIGHT_MISMATCH+WRONG_FEE": {
                        "color": "red",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {},
      "id": 111
    },
