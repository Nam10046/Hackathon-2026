          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT round((sum(p.kg_collected) / 1000)::numeric, 2) FROM pickups p JOIN compactors c ON c.id = p.compactor_id JOIN materials m ON m.name = c.material WHERE p.status = 'done' AND $__timeFilter(p.done_at)"
