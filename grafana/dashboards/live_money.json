          "format": "time_series",
          "rawSql": "SELECT done_at AS time, sum(co2_kg) OVER (ORDER BY done_at) AS \"CO₂ saved kg (running)\" FROM pickups WHERE status = 'done' AND $__timeFilter(done_at) ORDER BY 1"
