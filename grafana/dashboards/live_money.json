            "matcher": {
              "id": "byName",
              "options": "Total cost € (running)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyEUR"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CO₂ saved t (running)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: t"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {},
