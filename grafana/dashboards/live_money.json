            "type": "grafana-postgresql-datasource",
            "uid": "compactor-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT c.material AS \"Material\", round(sum(coalesce(m.lift_fee_eur, p.fee_eur, 0))) AS \"Lift costs\", round(sum((p.kg_collected * m.price_eur_per_kg))) AS \"Material value\", round(sum((coalesce(m.lift_fee_eur, p.fee_eur, 0) - (p.kg_collected * m.price_eur_per_kg)))) AS \"Total cost\" FROM pickups p JOIN compactors c ON c.id = p.compactor_id JOIN materials m ON m.name = c.material WHERE p.status = 'done' AND $__timeFilter(p.done_at) GROUP BY 1 ORDER BY 1"
