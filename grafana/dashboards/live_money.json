            "uid": "compactor-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT done_at AS time, sum(net_eur) OVER (ORDER BY done_at) AS \"Net € (running)\" FROM pickups WHERE status = 'done' AND $__timeFilter(done_at) ORDER BY 1"
        },
        {
          "refId": "B",
