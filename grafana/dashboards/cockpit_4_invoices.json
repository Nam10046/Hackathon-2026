    {
      "title": "All invoices",
      "description": "",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compactor-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compactor-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(CASE d.decision WHEN 'APPROVE' THEN 'approved' WHEN 'REJECT' THEN 'rejected' WHEN 'HOLD' THEN 'on hold' END, CASE WHEN i.suggestion = 'CHECK' THEN 'to check' ELSE 'matches' END) AS \"Status\", i.invoice_id AS \"Invoice\", i.customer_name AS \"Customer\", i.operator_name AS \"Waste company\", i.period_from AS \"From\", i.period_to AS \"To\", i.total_eur AS \"Billed €\", i.overcharged_eur AS \"Charged too much €\", i.unverified_eur AS \"Needs proof €\", i.lines_ok || ' / ' || i.lines_total AS \"Lines ok\", i.summary AS \"Check\", d.decided_by AS \"Decided by\" FROM invoices i LEFT JOIN (SELECT d.* FROM invoice_decisions d JOIN (SELECT invoice_id, MAX(id) AS max_id FROM invoice_decisions GROUP BY invoice_id) m ON m.max_id = d.id) d ON d.invoice_id = i.invoice_id WHERE i.customer_name IN ($customer) AND i.operator_name IN ($operator) ORDER BY i.entered_at DESC"
        }
      ],
