    {
      "title": "Lifts where scale and weighbridge differ by > 10 %",
      "description": "",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compactor-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT service_date AS \"Date\", customer_name AS \"Customer\", device_id AS \"Device\", operator_name AS \"Operator\", device_estimated_collected_kg AS \"Our scale kg\", weighbridge_net_kg AS \"Weighbridge kg\", round((100.0 * (weighbridge_net_kg - device_estimated_collected_kg) / NULLIF(device_estimated_collected_kg, 0))::numeric, 1) AS \"Difference %\", operator_job_ref AS \"Job ref\" FROM cp_collections WHERE weighbridge_net_kg IS NOT NULL AND device_estimated_collected_kg > 200 AND abs(weighbridge_net_kg - device_estimated_collected_kg) > 0.1 * device_estimated_collected_kg AND customer_name IN ($customer) AND material_stream IN ($material) AND $__timeFilter(service_date) ORDER BY abs(weighbridge_net_kg - device_estimated_collected_kg) DESC LIMIT 500"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
