  {
   "type": "table",
   "title": "Customers",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "compactor-pg"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "compactor-pg"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "table",
     "rawSql": "SELECT t.name AS \"Customer\", t.status AS \"Status\", count(d.compactor_id) AS \"Devices\",\n  (SELECT count(*) FROM users u WHERE u.tenant_id = t.id) AS \"Users\", sum(s.weight_kg) AS \"kg now\", sum(s.value_eur) AS \"Value €\"\nFROM tenants t LEFT JOIN tenant_devices d ON d.tenant_id = t.id LEFT JOIN compactor_status s ON s.compactor_id = d.compactor_id\nGROUP BY t.id, t.name, t.status ORDER BY t.name"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "–"
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 24,
    "h": 7
   },
   "id": 6
  },
  {
   "type": "table",
   "title": "Devices and owners",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "compactor-pg"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "compactor-pg"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "table",
     "rawSql": "SELECT c.id AS \"Device\", c.name AS \"Name\", coalesce(t.name, '(no owner)') AS \"Customer\", s.load_pct AS \"Full %\", s.last_ts AS \"Last reading\"\nFROM compactors c LEFT JOIN tenant_devices d ON d.compactor_id = c.id LEFT JOIN tenants t ON t.id = d.tenant_id\nLEFT JOIN compactor_status s ON s.compactor_id = c.id ORDER BY 3, 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "–"
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 24,
    "h": 9
   },
   "id": 7
  },
  {
   "type": "timeseries",
   "title": "Readings per customer",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "compactor-pg"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "compactor-pg"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "time_series",
     "rawSql": "SELECT date_trunc('hour', r.ts) AS \"time\", coalesce(t.name, '(no owner)') AS metric, count(*) AS value\nFROM readings r LEFT JOIN tenant_devices d ON d.compactor_id = r.compactor_id LEFT JOIN tenants t ON t.id = d.tenant_id\nWHERE $__timeFilter(r.ts) GROUP BY 1, 2 ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "drawStyle": "line",
      "spanNulls": true
     }
    },
    "overrides": []
   },
