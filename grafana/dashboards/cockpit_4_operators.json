    {
      "title": "On-time lifts %",
      "description": "",
      "type": "bargauge",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compactor-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT operator_name AS \"Operator\", round((100 * avg(on_time_rate))::numeric, 1) AS \"On time %\" FROM cp_scorecard WHERE operator_name IN ($operator) GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
