          "rawSql": "SELECT operator_name AS \"Operator\", region_code AS \"Region\", round((100 * avg(on_time_rate))::numeric, 1) AS \"On time %\", round((100 * avg(missed_visit_rate))::numeric, 2) AS \"Missed visits %\", round((100 * avg(weighbridge_shared_7d_rate))::numeric, 1) AS \"Tickets shared ≤ 7 d %\", round(avg(median_share_lag_days)::numeric, 1) AS \"Sharing delay (days)\", round(avg(weight_bias_pct)::numeric, 2) AS \"Weight bias %\", round(avg(billing_overcharge_pct)::numeric, 2) AS \"Overcharge %\", round(avg(billing_undercharge_pct)::numeric, 2) AS \"Undercharge %\", round((100 * avg(discrepant_line_rate))::numeric, 2) AS \"Discrepant lines %\" FROM cp_scorecard WHERE operator_name IN ($operator) GROUP BY 1, 2 ORDER BY 1, 2"
