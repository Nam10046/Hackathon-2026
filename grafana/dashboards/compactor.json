    {
      "type": "table",
      "title": "Trucks: booked and on the way",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compactor-pg"
      },
      "description": "'scheduled' = the old fixed route will still come at a set load, without looking at the sensor",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compactor-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT id AS \"#\", compactor_id AS \"Compactor\", kind AS \"Who\", status AS \"Status\", booked_load_pct AS \"Booked at %\", CASE WHEN cmd_sent_at IS NOT NULL THEN 'arrived' ELSE round((extract(epoch FROM truck_due - now()) / 3600 * 60.0)::numeric, 1)::text || ' h' END AS \"Arrives in (site)\", CASE WHEN truck_late THEN 'late' ELSE '' END AS \"Note\" FROM pickups WHERE status IN ('booked', 'scheduled') ORDER BY id DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ON_TIME": {
                        "color": "green",
                        "index": 0
                      },
                      "TOO_EARLY": {
                        "color": "orange",
                        "index": 1
                      },
                      "TOO_LATE": {
                        "color": "red",
                        "index": 2
                      },
                      "booked": {
                        "color": "blue",
                        "index": 3
                      },
                      "scheduled": {
                        "color": "purple",
                        "index": 4
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {},
      "id": 111
    },
