{
  "uid": "smart-compactor",
  "title": "6 Live sensors",
  "tags": [
    "europress-cockpit",
    "live"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "10s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "How to read this page",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Live data from real sensors** (ESP32 / Node-RED test buttons), not the Europress year. Each reading is checked by the rules and the **live lift model** — alerts appear in the table at the bottom. *Last seen* turns red when a sensor stops sending."
      }
    },
    {
      "id": 1,
      "title": "Net value now (EUR)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compactor-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compactor-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(sum(value_eur)::numeric, 2) AS \"Net value now (EUR)\" FROM compactor_status"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "title": "CO2 saved now",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compactor-pg"
      },
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compactor-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(sum(co2_saved_kg)::numeric) AS \"CO2 saved now (kg)\" FROM compactor_status"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "masskg"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "title": "Warnings (last 24 h)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compactor-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compactor-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"Warnings (24 h)\" FROM alerts WHERE severity <> 'info' AND ts > now() - interval '24 hours'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "title": "Next pickup needed in",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compactor-pg"
      },
      "gridPos": {
        "x": 18,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compactor-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(min(hours_to_full)::numeric, 1) AS \"Next pickup in (h)\" FROM compactor_status"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "title": "Load per compactor",
      "type": "bargauge",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compactor-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compactor-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT c.name AS \"Compactor\", s.load_pct AS \"Load\" FROM compactor_status s JOIN compactors c ON c.id = s.compactor_id ORDER BY c.id"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        }
      }
    },
    {
      "id": 6,
      "title": "Weight over time (kg)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compactor-pg"
      },
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compactor-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS \"time\", compactor_id AS metric, weight_kg FROM readings WHERE $__timeFilter(ts) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "masskg",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Status",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compactor-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compactor-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT c.id AS \"ID\", c.name AS \"Name\", c.material AS \"Material\", s.weight_kg AS \"Weight (kg)\", s.load_pct AS \"Load %\", s.density_kg_m3 AS \"Density (kg/m3)\", s.value_eur AS \"Value (EUR)\", s.hours_to_full AS \"Full in (h)\", s.last_ts AS \"Last reading\", round((extract(epoch FROM now() - s.last_ts) / 60)::numeric) AS \"Last seen (min ago)\" FROM compactors c LEFT JOIN compactor_status s ON s.compactor_id = c.id ORDER BY c.id"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last seen (min ago)"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 5
                    },
                    {
                      "color": "red",
                      "value": 15
                    }
                  ]
                }
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Fill level over time (%)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compactor-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compactor-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS \"time\", compactor_id AS metric, fill_pct FROM readings WHERE $__timeFilter(ts) AND fill_pct IS NOT NULL ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "Latest alerts",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compactor-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compactor-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ts AS \"Time\", compactor_id AS \"Compactor\", severity AS \"Severity\", type AS \"Type\", message AS \"Message\" FROM alerts WHERE $__timeFilter(ts) ORDER BY ts DESC, id DESC LIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "color": "red"
                      },
                      "warning": {
                        "color": "orange"
                      },
                      "info": {
                        "color": "blue"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {}
    }
  ],
  "templating": {
    "list": []
  },
