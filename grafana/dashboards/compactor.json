    {
      "type": "timeseries",
      "title": "Load over time (%) — dashed = on-call 80 %, purple marks = pickups",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compactor-pg"
      },
      "description": "",
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compactor-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT r.ts AS time, r.compactor_id AS metric, round((greatest(r.weight_kg / c.capacity_kg * 100, coalesce(r.fill_pct, 0)))::numeric, 1) AS load FROM readings r JOIN compactors c ON c.id = r.compactor_id WHERE $__timeFilter(r.ts) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 105,
          "custom": {
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": 60000,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "id": 110
