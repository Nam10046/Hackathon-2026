          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT ts AS \"Time\", compactor_id AS \"Compactor\", weight_kg AS \"Weight (kg)\", fill_pct AS \"Fill %\", seq AS \"Seq\", edge_quality AS \"Quality\", spikes_filtered AS \"Spikes removed (since boot)\", CASE WHEN from_buffer THEN 'yes' ELSE '' END AS \"From buffer\", CASE WHEN verified THEN '✓ signed' WHEN verified IS FALSE THEN '✗ BAD SIGNATURE' ELSE 'not signed' END AS \"Signature\" FROM readings ORDER BY ts DESC, id DESC LIMIT 20"
        }
