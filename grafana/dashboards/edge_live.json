    {
      "type": "table",
      "title": "Per compactor",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compactor-pg"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compactor-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT c.id AS \"Compactor\", c.material AS \"Material\", round(extract(epoch FROM now() - max(r.ts)))::int AS \"Last seen (s)\", count(r.*) AS \"Readings\", round(100.0 * count(*) FILTER (WHERE r.verified) / NULLIF(count(r.*), 0)) AS \"Verified %\", max(r.spikes_filtered) AS \"Spikes removed\", count(*) FILTER (WHERE r.from_buffer) AS \"From buffer\", (array_agg(r.edge_quality ORDER BY r.ts DESC))[1] AS \"Quality now\" FROM compactors c LEFT JOIN readings r ON r.compactor_id = c.id AND $__timeFilter(r.ts) GROUP BY c.id, c.material ORDER BY c.id"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Quality now"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "OK": {
                        "color": "green",
                        "index": 0
                      },
                      "STUCK": {
                        "color": "red",
                        "index": 1
                      },
                      "OVERLOAD": {
                        "color": "red",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {},
      "id": 109
    },
