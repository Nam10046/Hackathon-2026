          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compactor-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT replace(lower(label_family), '_', ' ') AS \"Finding\", count(*) AS \"Count\" FROM cp_flags WHERE customer_name IN ($customer) AND operator_name IN ($operator) AND label_family IN ($finding) GROUP BY 1 ORDER BY 2 DESC"
