      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compactor-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(sum(a.flagged_invoice_eur)::numeric) AS v FROM cp_actions a LEFT JOIN (SELECT ad.* FROM action_decisions ad JOIN (SELECT action_id, MAX(id) AS max_id FROM action_decisions GROUP BY action_id) m ON m.max_id = ad.id) d ON d.action_id = a.action_id WHERE (a.customer_name IN ($customer) AND a.operator_name IN ($operator)) AND (d.decision IS NULL OR d.decision = 'REVERT')"
        }
      ],
      "fieldConfig": {
        "defaults": {
