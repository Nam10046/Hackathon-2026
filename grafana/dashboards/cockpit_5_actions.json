    {
      "title": "All proposals (biggest euros first)",
      "description": "",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compactor-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compactor-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(CASE d.decision WHEN 'APPROVE' THEN 'approved' WHEN 'REJECT' THEN 'rejected' END, 'waiting') AS \"Status\", CASE a.action WHEN 'DISPUTE_INVOICE' THEN 'Ask the operator to correct the invoice' WHEN 'REQUEST_WEIGHBRIDGE_DATA' THEN 'Ask for the weight tickets' WHEN 'RENEGOTIATE_CONTRACT' THEN 'Renegotiate the price' WHEN 'TENDER_OR_SWITCH_OPERATOR' THEN 'Get offers from other waste companies' ELSE a.action END AS \"Proposal\", a.customer_name AS \"Customer\", a.operator_name AS \"Waste company\", a.flagged_invoice_eur AS \"Euros\", d.decided_by AS \"Decided by\" FROM cp_actions a LEFT JOIN (SELECT ad.* FROM action_decisions ad JOIN (SELECT action_id, MAX(id) AS max_id FROM action_decisions GROUP BY action_id) m ON m.max_id = ad.id) d ON d.action_id = a.action_id WHERE a.customer_name IN ($customer) AND a.operator_name IN ($operator) ORDER BY a.flagged_invoice_eur DESC"
        }
      ],
