    {
      "type": "stat",
      "title": "Pickups in this view",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compactor-pg"
      },
      "description": "Zero here means nothing was recorded. It does not mean the system failed. Widen the time range at the top right to see older pickups.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 10,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compactor-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT CASE\n  WHEN total = 0 THEN 'No pickups recorded yet'\n  WHEN in_range = 0 THEN 'None in this time range. ' || total || ' recorded, latest ' || to_char(latest AT TIME ZONE 'UTC', 'YYYY-MM-DD HH24:MI') || ' UTC'\n  ELSE in_range || ' of ' || total || ' recorded pickups' || CASE WHEN incomplete > 0 THEN ', ' || incomplete || ' with a missing measurement' ELSE '' END\n  END AS \"Pickups\"\nFROM (SELECT count(*) AS total, max(done_at) AS latest,\n        count(*) FILTER (WHERE $__timeFilter(done_at)) AS in_range,\n        count(*) FILTER (WHERE $__timeFilter(done_at) AND (kg_collected IS NULL OR load_before_pct IS NULL)) AS incomplete\n      FROM pickups WHERE status = 'done') t"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Data unavailable",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "text": {
          "valueSize": 17
        }
      },
      "id": 103
    },
    {
      "type": "stat",
      "title": "Device readings",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compactor-pg"
      },
      "description": "Latest reading from any compactor. Silent means no reading for 2 hours or more, so new pickups cannot be detected.",
      "gridPos": {
        "x": 10,
        "y": 5,
        "w": 6,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compactor-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT CASE\n  WHEN last_ts IS NULL THEN 'No readings received yet'\n  WHEN last_ts > now() - interval '2 hours' THEN 'Arriving, latest ' || to_char(last_ts AT TIME ZONE 'UTC', 'HH24:MI') || ' UTC'\n  ELSE 'Silent since ' || to_char(last_ts AT TIME ZONE 'UTC', 'YYYY-MM-DD HH24:MI') || ' UTC'\n  END AS \"Readings\"\nFROM (SELECT max(ts) AS last_ts FROM readings) t"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Data unavailable",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "text": {
          "valueSize": 17
        }
      },
      "id": 104
    },
    {
      "type": "stat",
      "title": "Source of these pickups",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compactor-pg"
      },
      "description": "Demo seed rows were never produced by a board. ESP32 pickups run through real edge processing, but on a simulated load cell. No weight here is a real measurement.",
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compactor-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT CASE\n  WHEN n = 0 THEN 'No pickups to describe'\n  WHEN seeded = n THEN 'SIMULATED: ' || n || ' demo seed, not from a board'\n  WHEN board = n THEN 'SIMULATED load cell: ' || n || ' from the ESP32'\n  WHEN seeded + board = n THEN 'SIMULATED: ' || seeded || ' demo seed, ' || board || ' from the ESP32'\n  ELSE 'NOT VERIFIED: ' || (n - seeded - board) || ' of ' || n || ' have no known source' END AS \"Source\"\nFROM (SELECT count(*) AS n, count(*) FILTER (WHERE r.edge_quality = 'simulated') AS seeded,\n        count(*) FILTER (WHERE r.seq IS NOT NULL AND coalesce(r.edge_quality, '') <> 'simulated') AS board\n      FROM pickups p LEFT JOIN readings r ON r.compactor_id = p.compactor_id AND r.ts = p.done_at\n      WHERE p.status = 'done' AND $__timeFilter(p.done_at)) s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Data unavailable",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": [
            {
              "type": "regex",
              "options": {
                "pattern": "^(SIMULATED|NOT VERIFIED).*",
                "result": {
                  "color": "#D79A32",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "text": {
          "valueSize": 17
        }
      },
      "id": 105
