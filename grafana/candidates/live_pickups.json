          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT p.id AS \"#\", p.done_at AS \"Emptied\", p.compactor_id AS \"Compactor\", c.material AS \"Material\", p.kind AS \"Who\", p.load_before_pct AS \"Load %\", p.kg_collected AS \"kg\", p.wait_hours AS \"Wait (site h)\", p.full_hours AS \"Full for (site h)\", p.verdict AS \"Verdict\", p.verdict_reason AS \"Why\", p.net_eur AS \"Net € (estimate)\", p.invoice_check AS \"Simulated invoice\", p.claim_eur AS \"Simulated claim €\", CASE WHEN r.edge_quality = 'simulated' THEN 'Demo seed' WHEN r.seq IS NOT NULL THEN 'ESP32, simulated load cell' ELSE 'Not verified' END AS \"Source\" FROM pickups p JOIN compactors c ON c.id = p.compactor_id LEFT JOIN readings r ON r.compactor_id = p.compactor_id AND r.ts = p.done_at WHERE p.status = 'done' AND $__timeFilter(p.done_at) ORDER BY p.done_at DESC"
