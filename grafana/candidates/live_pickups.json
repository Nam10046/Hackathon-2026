    {
      "type": "table",
      "title": "Pickup history",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compactor-pg"
      },
      "description": "Newest first. Source says where each pickup came from. A dash means the value was not recorded. Weights are simulated, net is an estimate with placeholder prices, and invoices are simulated.",
      "gridPos": {
