     "rawQuery": true,
     "format": "table",
     "rawSql": "SELECT ts AS \"Time\", compactor_id AS \"Compactor\", severity AS \"Severity\", type AS \"Type\", message AS \"What happened\"\nFROM tenant_api.alerts WHERE $__timeFilter(ts) AND compactor_id IN ($device) AND severity <> 'info' ORDER BY ts DESC LIMIT 100"
