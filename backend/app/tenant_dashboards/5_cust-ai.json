     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "time_series",
     "rawSql": "SELECT date_trunc('day', ts) AS \"time\", type AS metric, count(*) AS value FROM tenant_api.alerts WHERE $__timeFilter(ts) AND compactor_id IN ($device) AND severity <> 'info' GROUP BY 1, 2 ORDER BY 1"
    }
