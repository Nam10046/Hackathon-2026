   "title": "CO₂ saved per day",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "tenant-pg"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "tenant-pg"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "time_series",
     "rawSql": "SELECT date_trunc('day', done_at) AS \"time\", compactor_id AS metric, sum(co2_kg) AS value FROM tenant_api.pickups WHERE status = 'done' AND $__timeFilter(done_at) AND compactor_id IN ($device) GROUP BY 1, 2 ORDER BY 1"
    }
   ],
