    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "tenant-pg"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "table",
     "rawSql": "SELECT c.material AS \"Material\", sum(p.kg_collected) AS \"kg collected\", sum(p.co2_kg) AS \"CO₂ saved kg\", m.co2_factor AS \"Factor\"\nFROM tenant_api.pickups p JOIN tenant_api.compactors c ON c.id = p.compactor_id JOIN tenant_api.materials m ON m.name = c.material\nWHERE p.status = 'done' AND $__timeFilter(p.done_at) AND p.compactor_id IN ($device) GROUP BY 1, 4 ORDER BY 3 DESC"
    }
   ],
   "fieldConfig": {
    "defaults": {
