     "editorMode": "code",
     "rawQuery": true,
     "format": "table",
     "rawSql": "SELECT compactor_id AS \"Compactor\", status AS \"Status\", kind AS \"Type\", booked_at AS \"Booked\", booked_load_pct AS \"Booked at %\", truck_due AS \"Truck due\"\nFROM tenant_api.pickups WHERE status IN ('booked', 'scheduled') AND compactor_id IN ($device) ORDER BY truck_due NULLS LAST"
