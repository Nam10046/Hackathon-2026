   "title": "Latest warnings",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "tenant-pg"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "tenant-pg"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "table",
     "rawSql": "SELECT ts AS \"Time\", compactor_id AS \"Compactor\", severity AS \"Severity\", message AS \"What happened\"\nFROM tenant_api.alerts WHERE severity <> 'info' ORDER BY ts DESC LIMIT 8"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "–"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Severity"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "info": {
            "color": "blue",
            "index": 0
           },
           "warning": {
            "color": "orange",
            "index": 1
           },
           "critical": {
            "color": "red",
            "index": 2
           }
          }
         }
        ]
       }
      ]
     }
