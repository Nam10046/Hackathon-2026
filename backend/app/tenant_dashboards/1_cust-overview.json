    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "tenant-pg"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "table",
     "rawSql": "SELECT c.name AS \"Compactor\", c.material AS \"Material\", s.load_pct AS \"Full %\", s.weight_kg AS \"kg\",\n  s.value_eur AS \"Value €\", s.hours_to_full AS \"Full in h\", s.last_ts AS \"Last reading\"\nFROM tenant_api.compactors c LEFT JOIN tenant_api.compactor_status s ON s.compactor_id = c.id ORDER BY c.id"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "–"
    },
