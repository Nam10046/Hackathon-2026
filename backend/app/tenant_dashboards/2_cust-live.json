   "options": {
    "mode": "markdown",
    "content": "### Weight and fill level\nUpdates by itself every 30 seconds.\n\n**Real** = recorded by the system · **Estimated** = calculated with placeholder prices or factors · **Simulated** = not from physical hardware or a real operator"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 4
   },
   "id": 1
  },
  {
   "type": "stat",
   "title": "Where the weights on this page come from",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "tenant-pg"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "tenant-pg"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "table",
     "rawSql": "SELECT CASE\n  WHEN count(*) = 0 THEN 'No readings yet'\n  WHEN bool_and(coalesce(edge_quality, '') = 'simulated') THEN 'SIMULATED: made-up demo history, no device connected'\n  WHEN bool_or(seq IS NOT NULL) THEN 'SIMULATED load cell: real ESP32 edge processing, no physical sensor yet'\n  ELSE 'SOURCE NOT VERIFIED: readings without a device counter' END AS \"Source\"\nFROM (SELECT edge_quality, seq FROM tenant_api.readings ORDER BY ts DESC LIMIT 100) r"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "fixed",
      "fixedColor": "#8A5A00"
     },
     "noValue": "No readings yet"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "/.*/",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "text": {
     "valueSize": 20
    }
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 3
   },
   "id": 2
  },
  {
   "type": "gauge",
   "title": "Fill level now (simulated)",
