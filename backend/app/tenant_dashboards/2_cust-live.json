     "editorMode": "code",
     "rawQuery": true,
     "format": "table",
     "rawSql": "SELECT c.name AS metric, s.load_pct AS value\nFROM tenant_api.compactor_status s JOIN tenant_api.compactors c ON c.id = s.compactor_id WHERE s.compactor_id IN ($device) ORDER BY c.id"
    }
   ],
   "fieldConfig": {
    "defaults": {
